# Security + caching headers for static assets (Workers Static Assets reads this file).
# CSP: everything same-origin, plus Cloudflare Turnstile. The sha256 is the inline legacy-fallback script in index.html;
# test/core.test.js fails if they drift apart. Stripe Checkout is a full-page redirect, so it needs no allowance.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-UMe4VITnKwCURXiErvxb2Sq2eifynL4BG4TAiy6sQdc=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable
