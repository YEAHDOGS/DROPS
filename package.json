{
  "name": "@dogs/drops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "db:init": "wrangler d1 migrations apply DB --local",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "battle": "node test/battle.mjs",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.50.0"
  }
}
